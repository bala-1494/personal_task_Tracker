# ──────────────────────────────────────────────
# Trakr — environment variables
# Copy this file to .env for local development.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Your Google Cloud project ID (required)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to your service account key JSON (local dev only).
# On Cloud Run this is not needed — the runtime service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Port the server listens on (Cloud Run sets this automatically)
PORT=8080
